{
  "name": "talentgraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A CognoDB-backed organizational skill and collaboration graph.",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "smoke": "npm run smoke --workspace server",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "lint": "npm run lint --workspaces --if-present"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
